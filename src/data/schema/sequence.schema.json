{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sequence.schema.json",
  "title": "Sequence",
  "type": "object",
  "required": ["id", "category", "title", "steps", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$",
      "description": "Stable unique id, format '<prefix>-###', e.g. seq-001"
    },
    "category": {
      "type": "string",
      "enum": [
        "core-rules",
        "terrain-missions",
        "aquilon-tempestus",
        "frelons-vespides",
        "yaegirs-hernkogs",
        "exo-armures-stealth",
        "cibleurs",
        "cercle-canoptek",
        "deathwatch"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "description": "Steps in their correct canonical order.",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 3,
      "maxItems": 8
    },
    "status": {
      "type": "string",
      "enum": ["draft", "verified"]
    },
    "sourceRef": {
      "type": "string"
    }
  }
}
